# Browser-visible, non-secret Central Preview API origin shared by Merchant and Consumer.
# Leave blank unless connecting to the same development-only in-memory Root Mock; local example: http://127.0.0.1:3000.
# Do not set a hosted production/staging origin until physical isolation evidence and a separate Go approval are complete.
VITE_CENTRAL_MOCK_URL=

# Local/staging payment integration. Keep payment actions disabled until a DB migration,
# test credentials, and an external HTTPS callback origin are available.
PAYMENT_ENVIRONMENT=test
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_DATA_ENCRYPTION_KEY=

PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

DANAL_CLIENT_KEY=
DANAL_SECRET_KEY=
DANAL_MERCHANT_ID=
DANAL_MOBILE_ITEM_CODE=
