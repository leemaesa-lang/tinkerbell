# Optional browser-safe API origin. Leave empty to use this consumer app's same-origin /api.
# For the central dashboard bridge, set to the dashboard origin, e.g. https://dashboard.example.com
VITE_DANGAM_API_URL=
# Optional central Mock tRPC origin for membership test payments and partner applications.
# This is a browser-safe origin; it must point to the same central dashboard used by the REST bridge.
# Enter an origin; the Consumer REST resolver normalizes it to the /api base path before claim-write checks.
# Current Root Mock REST routes are development-only. Leave unset on hosted staging/production until the isolated Root API is approved.
# Preview coupon claim writes are enabled only for localhost:3104 or an HTTPS Manus-forwarded 3104-*.manus.computer Mock origin; other destinations are fail-closed.
VITE_CENTRAL_MOCK_URL=
VITE_APP_ENV=production

# Server-side values: set these only in the external server secret manager.
DATABASE_URL=mysql://USER:PASSWORD@DB_HOST:3306/DATABASE_NAME
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.example.com
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=replace-with-owner-name

# Production payment/identity adapters are intentionally disabled until credentials are issued.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-after-pg-contract
DANAL_MERCHANT_ID=replace-after-danal-contract
PORTONE_STORE_ID=replace-after-portone-contract
PORTONE_API_SECRET=replace-after-portone-contract
