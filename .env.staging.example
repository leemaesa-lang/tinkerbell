# Tinkerbell 외부 staging용 구조 예시입니다. 실제 배포 승인이나 격리 증빙을 뜻하지 않습니다.
# 현재 Track B staging은 NO-GO입니다. 이 파일을 공개 서버에 그대로 배포하지 마세요.
# NODE_ENV=development는 공개 Mock 운영 API 및 wildcard CORS를 활성화할 수 있으므로 외부 서버에서 금지합니다.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 별도 격리 인프라와 Go 승인 전까지 비워 둡니다. 운영 Root DB 주소를 복사하지 마세요.
DATABASE_URL=
DRIZZLE_DATABASE_URL=

# Manus 인증·세션·프로젝트 연동은 이 번들에서 비활성화합니다. 실제 키를 입력하지 마세요.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_API_URL=
MANUS_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Danal/PortOne은 미연동 상태입니다. test 표시는 외부 요청 허용이 아니며 키는 모두 비워 둡니다.
PAYMENT_ENVIRONMENT=test
PAYMENT_TEST_MODE=false
PAYMENT_PROVIDER=
PAYMENT_CLIENT_KEY=
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_DATA_ENCRYPTION_KEY=
DANAL_CLIENT_KEY=
DANAL_SECRET_KEY=
DANAL_MERCHANT_ID=
DANAL_CPID=
DANAL_MOBILE_ITEM_CODE=
DANAL_CALLBACK_BASE_URL=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_API_SECRET=

# 본인확인·PII 해시·최고관리자 전화번호 공개는 기본 차단합니다.
IDENTITY_HASH_SECRET=
IDENTITY_TEST_MODE=false
TINKERBELL_SUPER_ADMIN_OPEN_IDS=
TINKERBELL_DATA_ENCRYPTION_KEY=

# 사업자 계정/매장 PIN/Consumer-to-Merchant private API는 미연동입니다.
TINKERBELL_MERCHANT_API_SECRET=
TINKERBELL_STORE_PIN_MAP=
CONSUMER_APP_ORIGINS=
API_DEV_FALLBACK=false

# Consumer/Merchant 브라우저 연결은 승인된 비공개 Mock Gateway가 준비될 때까지 비웁니다.
# VITE_* 값은 브라우저 번들에 노출될 수 있으므로 provider 비밀키를 넣지 마세요.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_CENTRAL_MOCK_URL=
VITE_DANGAM_API_URL=
VITE_API_BASE_URL=
VITE_API_MOCK_FALLBACK=false
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# SMS/알림톡/FCM/웹푸시/AI/관측/송금 provider는 연결하지 않습니다.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
KAKAO_REST_API_KEY=
FCM_SERVER_KEY=
FIREBASE_PRIVATE_KEY=
SMS_API_KEY=
OPENAI_API_KEY=
SENTRY_DSN=

# 개발 Mock API는 production route에 포함되지 않으며 외부 staging Mock 로그인을 제공하지 않습니다.
# 독립 Consumer/Merchant 서버 포트는 격리 승인 후 각 서버에서 별도 설정하세요.
